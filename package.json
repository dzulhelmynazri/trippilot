{
  "name": "trippilot",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env ./node_modules/.bin/eve build",
    "deploy": "node --env-file=.env ./node_modules/.bin/eve deploy",
    "dev": "node --env-file=.env ./node_modules/.bin/eve dev",
    "eval": "node --env-file=.env ./node_modules/.bin/eve eval",
    "eval:smoke": "node --env-file=.env ./node_modules/.bin/eve eval smoke",
    "eval:reliability": "node --env-file=.env ./node_modules/.bin/eve eval reliability",
    "eval:usefulness": "node --env-file=.env ./node_modules/.bin/eve eval usefulness",
    "eval:originality": "node --env-file=.env ./node_modules/.bin/eve eval originality",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@composio/core": "^0.18.1",
    "@composio/experimental": "^0.2.4",
    "@upstash/agentkit-eve": "^0.9.0",
    "@upstash/redis": "^1.38.4",
    "ai": "^7.0.93",
    "dedent": "^1.7.2",
    "eve": "^0.53.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "microsandbox": "^0.5.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
